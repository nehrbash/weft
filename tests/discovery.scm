(use-modules (weft discovery) (weft transcripts) (weft runtime) (json)
             (srfi srfi-1) (srfi srfi-64))
(test-begin "discovery")
(define runner (test-runner-current))
(define root (mkdtemp "/tmp/weft-discovery-XXXXXX"))
(define home (string-append root "/claude"))
(define proc (string-append root "/proc"))
(for-each mkdir (list home proc (string-append home "/sessions")
                     (string-append home "/projects") (string-append home "/projects/-test")
                     (string-append proc "/42")))
(define (put path text) (call-with-output-file path (lambda (p) (display text p))))
(define (append-text path text)
  (let ((p (open-file path "a"))) (display text p) (close-port p)))
(define (json path data) (put path (scm->json-string data)))
(put (string-append proc "/42/stat")
     (string-append "42 (a name with ) parens) S "
                    (string-join (make-list 18 "0") " ") " 123 0\n"))
(define registry (string-append home "/sessions/42.json"))
(define (register start)
  (json registry `((pid . 42) (sessionId . "fixture") (cwd . "/test")
                   (name . "test") (status . "idle") (procStart . ,start)
                   (updatedAt . 1234000))))
(register "123")
(define path (string-append home "/projects/-test/fixture.jsonl"))
(define (line role text)
  (string-append (scm->json-string
    `((type . ,role) (timestamp . "2026-11-13T19:00:00Z")
      (message . ((role . ,role) (content . ,text))))) "\n"))
(define (codex-line role text turn channel)
  (string-append (scm->json-string
    `((type . "response_item") (payload . ((type . "message") (role . ,role)
      (channel . ,channel) (internal_chat_message_metadata_passthrough . ((turn_id . ,turn)))
      (content . #(((type . "input_text") (text . ,text)))))))) "\n"))
(put path (string-append (line "user" "Build a shared board") (line "assistant" "Board verified")
                        (line "user" "<local-command-stdout>Bye!</local-command-stdout>")))
(define calls '())
(define ids '("one" "two"))
(define broken #f)
(define offline? #f)
(define broken-page? #f)
(define (rpc method params)
  (set! calls (cons (cons method params) calls))
  (cond ((equal? method "thread/loaded/list")
         (if (assq-ref params 'cursor)
             (if broken-page? '(("data" . "invalid"))
                 `(("data" . ,(list->vector (cdr ids))) ("nextCursor" . null)))
             `(("data" . ,(list->vector (if (null? ids) '() (list (car ids)))))
               ("nextCursor" . ,(if (> (length ids) 1) "next" 'null)))))
        ((equal? method "thread/read")
         (when (equal? broken (assq-ref params 'threadId)) (error "Thread disappeared"))
         `(("thread" . (("name" . "native") ("cwd" . "/test")
                        ("path" . ,path) ("status" . (("type" . "active")))))))
        (else (error "Unexpected mutating request" method))))
(define (connect f) (when offline? (error "offline")) (f rpc))
(define inspector (make-session-inspector #:claude-home home #:proc proc #:connect connect))
(define (inspect . options) (apply session-list #:inspector inspector options))
(define (detail . options)
  (assq-ref (apply session-ref "claude:fixture" #:inspector inspector options) 'session))
(define result (inspect))
(test-equal "discovers native sessions across loaded pages" 3 (length (assq-ref result 'sessions)))
(test-equal "only read operations" '("thread/loaded/list" "thread/read")
  (sort (delete-duplicates (map car calls)) string<?))
(test-equal "latest request ignores local command noise" "Build a shared board"
  (assq-ref (detail) 'request))
(test-equal "timestamps use Unix seconds" 1234 (assq-ref (detail #:fields '(updated-at)) 'updated-at))
(test-equal "detail carries latest reply" "Board verified" (assq-ref (detail) 'reply))
(test-equal "no turn ID means sequence association, not verified pairing" 'sequence (assq-ref (detail) 'association))
(test-equal "field projection is exact" '(id status) (map car (detail #:fields '(id status))))
(test-equal "status filtering" 2 (length (assq-ref (inspect #:status 'active) 'sessions)))
(test-equal "provider filtering" 1 (length (assq-ref (inspect #:provider 'claude) 'sessions)))
(test-error "unknown field is not silently empty" #t (inspect #:fields '(typo)))
(test-error "invalid provider is explicit" #t (inspect #:provider 'typo))
(set! calls '())
(session-ref "codex:one" #:fields '(id status) #:inspector inspector)
(test-equal "single Codex lookup never lists other threads" '("thread/read") (map car calls))
(register "124")
(test-equal "PID reuse rejects stale Claude registry" 2 (length (assq-ref (inspect) 'sessions)))
(register "123")
(test-equal "missing session is explicit" #f
  (assq-ref (session-ref "claude:missing" #:inspector inspector) 'session))
(test-error "invalid identifier is rejected" #t (session-ref "../other" #:inspector inspector))
(set! broken "two")
(set! result (inspect #:provider 'codex))
(test-equal "one failed thread preserves successful reads" 1 (length (assq-ref result 'sessions)))
(test-equal "diagnostic names failed operation" 'thread-read (assq-ref (car (assq-ref result 'warnings)) 'operation))
(set! broken #f)
(set! broken-page? #t)
(test-equal "malformed later page preserves earlier rows" 1
  (length (assq-ref (inspect #:provider 'codex) 'sessions)))
(set! broken-page? #f)
(set! offline? #t)
(test-equal "provider outage preserves Claude" 1 (length (assq-ref (inspect) 'sessions)))
(set! offline? #f)
(put (string-append home "/sessions/broken.json") "{")
(test-equal "malformed registry is diagnosed" 'registry
  (assq-ref (car (assq-ref (inspect #:provider 'claude) 'warnings)) 'operation))
(delete-file (string-append home "/sessions/broken.json"))

(append-text path (line "user" "<html>New request</html>"))
(test-equal "legitimate markup is a request" "<html>New request</html>" (assq-ref (detail) 'request))
(test-equal "new request cannot inherit an old reply" #f (assq-ref (detail) 'reply))
(test-equal "new request is pending" 'pending (assq-ref (detail) 'association))
(append-text path (codex-line "assistant" "Private reasoning" "a" "analysis"))
(test-equal "reasoning is excluded" #f (assq-ref (detail) 'reply))
(put path (codex-line "user" "Turn B" "b" "final"))
(append-text path (codex-line "assistant" "Late turn A reply" "a" "final"))
(test-equal "mismatched turn reply is rejected" #f (assq-ref (detail) 'reply))
(append-text path (codex-line "assistant" "Turn B reply" "b" "final"))
(test-equal "matching native turns are labeled" 'turn (assq-ref (detail) 'association))

(put path (line "user" "Before partial write"))
(detail)
(define pending (line "assistant" "Completed partial write"))
(append-text path (substring pending 0 20))
(test-equal "partial JSON line does not replace known activity" "Before partial write" (assq-ref (detail) 'request))
(append-text path (substring pending 20))
(test-equal "partial record is completed on next read" "Completed partial write" (assq-ref (detail) 'reply))
(test-equal "completed append preserves full coverage" 'complete (assq-ref (detail) 'transcript))
(append-text path "{broken}\n")
(test-equal "complete malformed line is diagnosed" 'malformed-json
  (assq-ref (car (assq-ref (session-ref "claude:fixture" #:inspector inspector) 'warnings)) 'kind))
(put path (line "user" "Truncated"))
(test-equal "truncation clears old transcript state" #f (assq-ref (detail) 'reply))
(test-equal "truncation reads new request" "Truncated" (assq-ref (detail) 'request))
(define replacement (string-append root "/replacement"))
(put replacement (line "user" "Replaced inode"))
(rename-file replacement path)
(test-equal "inode replacement invalidates cache" "Replaced inode" (assq-ref (detail) 'request))
(put path (string-append (make-string 1100000 #\x) "\n" (line "user" "Recent bounded request")))
(test-equal "large transcript reads bounded tail" "Recent bounded request" (assq-ref (detail) 'request))
(test-equal "bounded history is labeled partial" 'partial (assq-ref (detail) 'transcript))
(put path "")
(test-equal "empty transcript is complete" 'complete (assq-ref (detail) 'transcript))
(delete-file path)
(test-equal "metadata-only inspection skips missing transcripts" '()
  (assq-ref (inspect #:fields '(id status)) 'warnings))
(test-equal "requested missing transcript is diagnosed" 'transcript
  (assq-ref (car (assq-ref (session-ref "claude:fixture" #:inspector inspector) 'warnings)) 'operation))
(put path (line "user" "Stable"))

(define transcript-module (resolve-module '(weft transcripts)))
(define parse-event (module-ref transcript-module 'message-event))
(define parsed 0)
(define cache (make-transcript-cache))
(dynamic-wind
  (lambda () (module-set! transcript-module 'message-event
              (lambda (entry) (set! parsed (+ parsed 1)) (parse-event entry))))
  (lambda ()
    (transcript-read cache path (lambda _ #f))
    (test-equal "initial read parses one record" 1 parsed)
    (transcript-read cache path (lambda _ #f))
    (test-equal "unchanged file performs no JSON parsing" 1 parsed)
    (append-text path (line "assistant" "One new record"))
    (transcript-read cache path (lambda _ #f))
    (test-equal "append parses only new records" 2 parsed))
  (lambda () (module-set! transcript-module 'message-event parse-event)))

(define (changes cursor) (session-changes cursor #:provider 'codex #:fields '(id status) #:inspector inspector))
(define baseline (changes #f))
(test-equal "first change query returns baseline" 2 (length (assq-ref baseline 'changed)))
(define unchanged (changes (assq-ref baseline 'cursor)))
(test-equal "unchanged query has no rows" '() (assq-ref unchanged 'changed))
(test-equal "unchanged query has no removals" '() (assq-ref unchanged 'removed))
(set! broken "two")
(define partial (changes (assq-ref unchanged 'cursor)))
(test-equal "failed read is not a removal" '() (assq-ref partial 'removed))
(set! broken #f)
(set! ids '("one"))
(define removed (changes (assq-ref partial 'cursor)))
(test-equal "confirmed disappearance is reported" '("codex:two") (assq-ref removed 'removed))
(test-error "cursor cannot change query shape" #t
  (session-changes (assq-ref removed 'cursor) #:fields '(id) #:inspector inspector))
(test-error "new inspector rejects foreign cursor" #t
  (session-changes (assq-ref removed 'cursor) #:provider 'codex #:fields '(id status)
    #:inspector (make-session-inspector #:claude-home home #:proc proc #:connect connect)))
(do ((i 0 (+ i 1))) ((= i 33)) (changes #f))
(test-error "old cursor expires explicitly" #t (changes (assq-ref baseline 'cursor)))

(mkdir (string-append proc "/43"))
(symlink "/fake/bin/codex" (string-append proc "/43/exe"))
(symlink "/test" (string-append proc "/43/cwd"))
(put (string-append proc "/43/cmdline") (string-append "codex" (string #\nul)))
(test-equal "unresolved process is not working" 'unknown
  (assq-ref (car (assq-ref (inspect #:provider 'process) 'sessions)) 'status))
(put (string-append proc "/43/cmdline")
     (string-append "codex" (string #\nul) "app-server" (string #\nul)))
(test-equal "app server is not an extra agent" '() (assq-ref (inspect #:provider 'process) 'sessions))
(define workspace (make-workspace))
(test-equal "trusted workspace installs all API procedures" "(#t #t #t)"
  (assq-ref (workspace-evaluate workspace "(map procedure? (list session-list session-ref session-changes))") 'value))
(test-equal "workspace binding accepts positional cursor before keywords" 'ok
  (assq-ref (workspace-evaluate workspace
    "(define baseline (session-changes #:provider 'process #:fields '(id))) (session-changes (assq-ref baseline 'cursor) #:provider 'process #:fields '(id))") 'status))
(test-equal "workspace binding accepts positional session ID" 'ok
  (assq-ref (workspace-evaluate workspace "(session-ref \"process:999999999\" #:fields '(id))") 'status))
(workspace-close workspace)
(define isolated (make-workspace #:isolated? #t))
(test-equal "isolated workspace cannot inspect host" 'error
  (assq-ref (workspace-evaluate isolated "(session-list)") 'status))
(workspace-close isolated)
(test-end "discovery")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
