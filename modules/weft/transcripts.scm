(define-module (weft transcripts)
  #:use-module (json)
  #:use-module (ice-9 match)
  #:use-module (ice-9 rdelim)
  #:use-module (rnrs bytevectors)
  #:use-module (rnrs io ports)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-11)
  #:use-module (srfi srfi-9)
  #:export (make-transcript-cache transcript-read))

(define-record-type <transcript>
  (make-transcript stamp offset anchor activity truncated? incomplete? malformed?)
  transcript?
  (stamp transcript-stamp)
  (offset transcript-offset)
  (anchor transcript-anchor)
  (activity transcript-activity)
  (truncated? transcript-truncated?)
  (incomplete? transcript-incomplete?)
  (malformed? transcript-malformed?))

(define (make-transcript-cache) (make-hash-table))
(define %tail-limit 1048576)
(define %empty '((request . #f) (reply . #f) (request-at . #f)
                 (reply-at . #f) (turn . #f) (association . unknown)))

(define (field object key)
  (and (list? object) (assoc-ref object key)))

(define (text-content content)
  (match content
    ((? string? text) text)
    ((? vector? parts)
     (string-join (filter-map (lambda (part)
       (and (member (field part "type") '("text" "input_text" "output_text"))
            (string? (field part "text"))
            (field part "text"))) (vector->list parts)) "\n"))
    (_ "")))

(define (protocol-text? text)
  (any (lambda (prefix) (string-prefix? prefix text))
       '("<local-command-caveat>" "<local-command-stdout>" "<command-name>"
         "<system-reminder>" "<environment_context>" "# AGENTS.md instructions")))

(define (message-event entry)
  (let* ((type (field entry "type"))
         (payload (field entry "payload"))
         (message (field entry "message"))
         (at (field entry "timestamp")))
    (define (event role text turn)
      (and (string? text) (not (string-null? text)) (not (protocol-text? text))
           (list role (substring text 0 (min (string-length text)
                                          (if (eq? role 'request) 320 640))) at turn)))
    (match (list type (field payload "type"))
      (("response_item" "message")
       (let ((turn (field (field payload "internal_chat_message_metadata_passthrough") "turn_id")))
         (match (list (field payload "role") (field payload "channel"))
           (("user" _) (event 'request (text-content (field payload "content")) turn))
           (("assistant" "analysis") #f)
           (("assistant" _) (event 'reply (text-content (field payload "content")) turn))
           (_ #f))))
      (((or "user" "assistant") _)
       (event (if (equal? type "user") 'request 'reply)
              (text-content (field message "content")) (field entry "turnId")))
      (_ #f))))

(define (advance activity event)
  (match event
    (('request text at turn)
     `((request . ,text) (reply . #f) (request-at . ,at) (reply-at . #f)
       (turn . ,turn) (association . pending)))
    (('reply text at turn)
     (let ((request-turn (assq-ref activity 'turn)))
       (if (and turn request-turn (not (equal? turn request-turn))) activity
           (append `((reply . ,text) (reply-at . ,at)
                     (association . ,(cond ((not (assq-ref activity 'request)) 'unpaired)
                                           ((and turn request-turn) 'turn)
                                           (else 'sequence))))
                   (filter (lambda (pair) (not (memq (car pair) '(reply reply-at association)))) activity)))))
    (_ activity)))

(define (stamp stat)
  (list (stat:dev stat) (stat:ino stat) (stat:size stat)
        (stat:mtime stat) (stat:mtimensec stat) (stat:ctime stat) (stat:ctimensec stat)))

(define (bytes-at port start count)
  (seek port start SEEK_SET)
  (if (zero? count) (make-bytevector 0) (get-bytevector-n port count)))

(define (anchor-at port offset)
  (bytes-at port (max 0 (- offset 128)) (min offset 128)))

(define (last-newline bytes)
  (let loop ((i (- (bytevector-length bytes) 1)))
    (cond ((< i 0) 0) ((= 10 (bytevector-u8-ref bytes i)) (+ i 1))
          (else (loop (- i 1))))))

(define (parse-lines bytes end skip-first? initial)
  (let ((port (open-bytevector-input-port bytes)))
    (set-port-encoding! port "UTF-8")
    (set-port-conversion-strategy! port 'substitute)
    (when skip-first? (read-line port))
    (let loop ((activity initial) (malformed? #f))
      (if (>= (port-position port) end)
          (values activity malformed?)
          (let* ((line (read-line port))
                 (entry (catch 'json-invalid
                          (lambda () (json-string->scm line))
                          (lambda _ #f))))
            (loop (advance activity (and entry (message-event entry)))
                  (or malformed? (not entry))))))))

(define (read-update path previous)
  (call-with-input-file path
    (lambda (port)
      (let* ((info (stat port)) (size (stat:size info)) (new-stamp (stamp info)))
        (if (and previous (equal? new-stamp (transcript-stamp previous))) previous
            (let* ((offset (and previous (transcript-offset previous)))
                   (append? (and previous
                                 (equal? (take new-stamp 2) (take (transcript-stamp previous) 2))
                                 (>= size offset)
                                 (> size (list-ref (transcript-stamp previous) 2))
                                 (equal? (anchor-at port offset) (transcript-anchor previous))))
                   (start (max (if append? offset 0) (- size %tail-limit)))
                   (continuous? (and append? (= start offset)))
                   (skip? (and (> start 0)
                               (not (= 10 (bytevector-u8-ref (bytes-at port (- start 1) 1) 0)))))
                   (bytes (bytes-at port start (- size start)))
                   (end (last-newline bytes))
                   (next (+ start end)))
              (let-values (((activity malformed?)
                            (parse-lines bytes end skip?
                              (if continuous? (transcript-activity previous) %empty))))
                (make-transcript new-stamp next (anchor-at port next) activity
                  (if continuous? (transcript-truncated? previous) (> start 0))
                  (< end (- size start))
                  (or malformed? (and continuous? (transcript-malformed? previous)))))))))))

(define (transcript-read cache path report)
  "Read appended records; REPORT receives diagnostic kind and message."
  (if (not (string? path)) (acons 'transcript 'unavailable %empty)
      (let ((entry (read-update path (hash-ref cache path))))
        (when (>= (hash-count (const #t) cache) 128)
          (hash-remove! cache (car (hash-map->list (lambda (key _) key) cache))))
        (hash-set! cache path entry)
        (when (transcript-malformed? entry)
          (report 'malformed-json "Skipped malformed transcript records."))
        (acons 'transcript (if (or (transcript-truncated? entry) (transcript-incomplete? entry)
                                  (transcript-malformed? entry)) 'partial 'complete)
               (transcript-activity entry)))))
