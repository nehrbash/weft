(define-module (weft sessions)
  #:use-module (json)
  #:use-module (ice-9 rdelim)
  #:use-module (ice-9 sandbox)
  #:use-module (rnrs io ports)
  #:use-module (web socket client)
  #:use-module (web socket utils)
  #:use-module (web response)
  #:use-module ((gnutls) #:select (base64-encode))
  #:export (call-with-codex codex-send codex-list))

(define (call-with-codex procedure)
  "Connect to the existing local app server without replacing its configuration."
  (let ((port (socket AF_UNIX (logior SOCK_STREAM SOCK_CLOEXEC) 0)) (id 0))
    (define (send message)
      (websocket-send port (scm->json-string message)))
    (define (rpc method params)
      (set! id (+ id 1))
      (send `((id . ,id) (method . ,method) (params . ,params)))
      (let loop ()
        (let ((line (websocket-receive port)))
          (unless (string? line) (error "Codex control socket closed"))
          (when (> (string-length line) 8388608) (error "Codex reply exceeded limit"))
          (let ((message (json-string->scm line)))
            (if (equal? id (assoc-ref message "id"))
                (if (assoc "error" message)
                    (error "Codex request failed" method (assoc-ref message "error"))
                    (assoc-ref message "result"))
                (loop))))))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (call-with-time-limit 20
          (lambda ()
            (connect port AF_UNIX
              (string-append (or (getenv "CODEX_HOME") (string-append (getenv "HOME") "/.codex"))
                             "/app-server-control/app-server-control.sock"))
            (let ((key (base64-encode (get-bytevector-n (default-entropy-port) 16))))
              (format port "GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ~a\r\nSec-WebSocket-Version: 13\r\n\r\n" key)
              (force-output port)
              (let ((response (read-response port)))
                (unless (and (= 101 (response-code response))
                             (equal? (assoc-ref (response-headers response) 'sec-websocket-accept)
                                     (make-accept-key key)))
                  (error "Codex WebSocket handshake rejected"))))
            (rpc "initialize" '((clientInfo . ((name . "weft") (version . "0.6.0")))
                                (capabilities . ((experimentalApi . #t)))))
            (send '((method . "initialized")))
            (procedure rpc))
          (lambda () (error "Codex control request timed out"))))
      (lambda () (close-port port)))))

(define (codex-send rpc thread prompt)
  "Queue a prompt on an existing task and start it only when idle."
  (let* ((result (rpc "thread/read" `((threadId . ,thread))))
         (status (assoc-ref (assoc-ref (assoc-ref result "thread") "status") "type")))
    (unless (member status '("idle" "active" "notLoaded"))
      (error "Task is not available" status))
    (when (equal? status "notLoaded") (rpc "thread/resume" `((threadId . ,thread))))
    (let* ((queued (rpc "thread/queue/add"
                    `((threadId . ,thread)
                      (clientUserMessageId . ,(format #f "weft-~a-~a" (getpid) (gettimeofday)))
                      (input . #(((type . "text") (text . ,prompt)))))))
           (submission (assoc-ref queued "queuedSubmission")))
      (unless (equal? status "active")
        (rpc "thread/queue/start"
             `((threadId . ,thread)
               ,@(if submission `((queuedSubmissionId . ,(assoc-ref submission "id"))) '()))))
      queued)))

(define (codex-list rpc)
  (rpc "thread/list" '((limit . 50) (archived . #f))))
