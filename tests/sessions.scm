(use-modules (weft sessions) (srfi srfi-64))
(test-begin "sessions")
(define runner (test-runner-current))
(define calls '())
(define status "active")
(define (rpc method params)
  (set! calls (cons (cons method params) calls))
  (cond
   ((equal? method "thread/read") `(("thread" . (("status" . (("type" . ,status)))))))
   ((equal? method "thread/queue/add") '(("queuedSubmission" . (("id" . "queued")))))
   (else '())))
(codex-send rpc "existing" "hello")
(test-equal "busy task queues without steering or starting" '("thread/queue/add" "thread/read") (map car calls))
(set! calls '()) (set! status "idle")
(codex-send rpc "existing" "hello")
(test-equal "idle task starts its queued submission"
  '("thread/queue/start" "thread/queue/add" "thread/read") (map car calls))
(test-equal "start names exact queued submission" "queued" (assq-ref (cdar calls) 'queuedSubmissionId))
(set! calls '()) (set! status "notLoaded")
(codex-send rpc "existing" "hello")
(test-equal "unloaded task resumes without model or permission overrides"
  '("thread/queue/start" "thread/queue/add" "thread/resume" "thread/read") (map car calls))
(test-equal "resume only identifies existing task" '((threadId . "existing")) (cdr (list-ref calls 2)))
(test-end "sessions")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
