(define-module (weft cli)
  #:use-module (weft mcp)
  #:use-module (weft daemon)
  #:use-module (weft isolated)
  #:use-module (weft sessions)
  #:use-module (ice-9 rdelim)
  #:use-module (ice-9 binary-ports)
  #:use-module (rnrs bytevectors)
  #:use-module (json)
  #:use-module (ice-9 match)
  #:export (main default-socket-path))

(define (room-socket) (string-append (dirname (default-socket-path)) "/room.sock"))
(define (room-directory)
  (string-append (or (getenv "XDG_STATE_HOME")
                     (string-append (getenv "HOME") "/.local/state")) "/weft"))
(define (owner-token-file) (string-append (room-directory) "/owner-token"))

(define (prepare-room!)
  (let ((directory (room-directory)))
    (unless (file-exists? directory) (mkdir directory #o700))
    (unless (and (= (getuid) (stat:uid (stat directory)))
                 (zero? (logand #o077 (stat:perms (stat directory)))))
      (error "Room state directory is not private"))
    (unless (file-exists? (owner-token-file))
      (let* ((bytes (call-with-input-file "/dev/urandom" (lambda (port) (get-bytevector-n port 32))))
             (port (fdopen (open-fdes (owner-token-file) (logior O_WRONLY O_CREAT O_EXCL) #o600) "w")))
        (dynamic-wind (lambda () #t)
          (lambda ()
            (do ((index 0 (+ index 1))) ((= index 32))
              (format port "~2,'0x" (bytevector-u8-ref bytes index)))
            (newline port))
          (lambda () (close-port port)))))))

(define (owner operation arguments)
  (let* ((token (call-with-input-file (owner-token-file) read-line))
         (reply (apply owner-request (room-socket) token operation arguments)))
    (if (eq? 'ok (assq-ref reply 'status))
        (begin (display (assq-ref reply 'value)) (newline) 0)
        (begin (display (assq-ref reply 'value) (current-error-port)) (newline (current-error-port)) 1))))

(define (owner-view)
  (let* ((token (call-with-input-file (owner-token-file) read-line))
         (reply (owner-request (room-socket) token 'inspect)))
    (unless (eq? 'ok (assq-ref reply 'status)) (error "Owner inspection failed"))
    (let ((state (call-with-input-string (assq-ref reply 'value) read)))
      (display
        (scm->json-string
          `((zones . ,(list->vector
                       (map (match-lambda
                              ((name type data)
                               `((name . ,(symbol->string name))
                                 (type . ,(symbol->string type))
                                 (rows . ,(if (memq type '(table wiring))
                                              (list->vector
                                                (map (lambda (row)
                                                       (list->vector
                                                         (map (lambda (cell)
                                                                (if (string? cell) cell (object->string cell))) row))) data))
                                              #()))
                                 (display . ,(case type
                                               ((text) data)
                                               ((metric) (if (string? data) data (number->string data)))
                                               (else ""))))))
                            (assq-ref state 'zones))))
            (effects . ,(list->vector
                         (map (lambda (entry)
                                (let ((effect (cdr entry)))
                                  `((id . ,(car entry))
                                    (state . ,(symbol->string (assq-ref effect 'state)))
                                    (type . ,(symbol->string (assq-ref effect 'type)))
                                    (expected . ,(object->string (list (assq-ref effect 'type) (assq-ref effect 'payload))))
                                    (receipt . ,(object->string (assq-ref effect 'receipt))))))
                              (reverse (assq-ref state 'effects))))))))
      (newline) 0)))

(define (notify-hook provider)
  (let* ((event (json->scm (current-input-port)))
         (text (or (assoc-ref event "last_assistant_message")
                   (assoc-ref event "last_agent_message")
                   (string-append provider " finished a turn")))
         (summary (substring text 0 (min (string-length text) 500))))
    (let ((reply (remote-evaluate (default-socket-path)
                   (object->string `(owner-post! ,summary #:from ',(string->symbol provider))))))
      (unless (eq? 'ok (assq-ref reply 'status)) (error "Owner message was not accepted")))
    0))

(define (default-socket-path)
  "Return this user's local workspace socket path."
  (string-append (if (getenv "XDG_RUNTIME_DIR")
                     (string-append (getenv "XDG_RUNTIME_DIR") "/weft")
                     (string-append "/tmp/weft-" (number->string (getuid))))
                 "/workspace.sock"))

(define* (main args #:key (initialize (lambda (module) #t)))
  "Run standalone MCP, a shared daemon, a bridge, or one Scheme evaluation."
  (define* (connect path #:optional isolated?)
    (serve-stdio #:isolated? isolated? #:evaluate
                 (lambda (code seconds)
                   (remote-evaluate path code #:seconds seconds))))
  (define (evaluate path code)
    (let ((result (remote-evaluate path code)))
      (write result)
      (newline)
      (if (eq? 'ok (assq-ref result 'status)) 0 1)))
  (match args
    (() (serve-stdio #:initialize initialize) 0)
    (("standalone") (serve-stdio #:initialize initialize) 0)
    (("daemon")
     (let ((state (getenv "WEFT_STATE_FILE")))
       (when (and state (not (file-exists? (dirname state)))) (mkdir (dirname state) #o700))
       (serve-workspace (default-socket-path) #:initialize initialize #:state-file state)) 0)
    (("daemon" path state) (serve-workspace path #:initialize initialize #:state-file state) 0)
    (("daemon" path) (serve-workspace path #:initialize initialize) 0)
    (("connect") (connect (default-socket-path)) 0)
    (("connect" path) (connect path) 0)
    (("room-daemon")
     (prepare-room!)
     (serve-isolated (room-socket) (string-append (room-directory) "/room.scm") (owner-token-file)) 0)
    (("connect-room") (connect (room-socket) #t) 0)
    (("room-eval" code) (evaluate (room-socket) code))
    (("owner" "inspect") (owner 'inspect '()))
    (("owner" "view") (owner-view))
    (("notify-hook" provider) (notify-hook provider))
    (("inbox")
     (let ((reply (remote-evaluate (default-socket-path) "(owner-messages)")))
       (unless (eq? 'ok (assq-ref reply 'status)) (error "Owner inbox unavailable"))
       (display (scm->json-string
                  (list->vector
                    (map (lambda (entry)
                           `((id . ,(assq-ref entry 'id))
                             (from . ,(symbol->string (assq-ref entry 'from)))
                             (text . ,(assq-ref entry 'text))))
                         (call-with-input-string (assq-ref reply 'value) read)))))
       (newline) 0))
    (("codex-send" thread prompt)
     (display (scm->json-string (call-with-codex (lambda (rpc) (codex-send rpc thread prompt)))))
     (newline) 0)
    (("codex-list")
     (display (scm->json-string (call-with-codex codex-list))) (newline) 0)
    (("owner" "archive" id) (owner 'archive (list (string->number id))))
    (("owner" decision id expected)
     (unless (member decision '("approve" "reject")) (error "Expected approve or reject"))
     (owner 'decide (list (string->number id) (call-with-input-string expected read)
                         (string->symbol decision))))
    (("eval" code) (evaluate (default-socket-path) code))
    (("eval" path code) (evaluate path code))
    (_ (display "Usage: weft [standalone | daemon [SOCKET [STATE]] | connect [SOCKET] | eval [SOCKET] CODE | room-daemon | connect-room | room-eval CODE | owner inspect | owner approve/reject ID EXPECTED | owner archive ID]\n"
                (current-error-port))
       2)))
