(define-module (weft mcp)
  #:use-module (weft runtime)
  #:use-module (json)
  #:use-module (ice-9 rdelim)
  #:use-module (srfi srfi-1)
  #:export (serve-mcp serve-stdio))

(define %tool
  '((name . "evaluate")
    (description . "Evaluate Guile Scheme in a persistent local workspace. Start with (workspace-help) and (workspace-state). Definitions, jobs and agent orchestration belong to the workspace host. This trusted REPL runs with the local user's authority; no sandbox or approval gate.")
    (inputSchema (type . "object")
                 (properties (code (type . "string")
                                   (maxLength . 131072))
                             (seconds (type . "number")
                                      (exclusiveMinimum . 0)
                                      (maximum . 50)))
                 (required . #("code"))
                 (additionalProperties . #f))
    (annotations (readOnlyHint . #f)
                 (destructiveHint . #t)
                 (idempotentHint . #f)
                 (openWorldHint . #t))))

(define (object? value)
  (and (list? value)
       (every (lambda (entry)
                (and (pair? entry) (string? (car entry)))) value)))

(define (rpc-error id code message)
  `((jsonrpc . "2.0") (id . ,id)
    (error (code . ,code) (message . ,message))))

(define* (serve-mcp input output #:key (initialize (lambda (module) #t))
                    (evaluate #f) isolated?)
  "Serve MCP using an owned workspace or an externally owned EVALUATE callback."
  (define workspace (and (not evaluate) (make-workspace #:initialize initialize)))
  (define run (or evaluate (lambda (code seconds)
                            (workspace-evaluate workspace code #:seconds seconds))))
  (define initialized? #f)
  (define description
    (if isolated?
        "Evaluate restricted Scheme in a shared Bubblewrap-isolated room. Use workspace-help and workspace-state. saved-define!/saved-set! persist explicit definitions and values; zone-set! publishes typed zones. effect-propose! requests notify/write-file/run/session-send effects for exact-content owner approval; agents cannot approve through this evaluator."
        (assq-ref %tool 'description)))
  (define (result id value)
    `((jsonrpc . "2.0") (id . ,id) (result . ,value)))
  (define (dispatch request)
    (let ((id (assoc-ref request "id"))
          (method (assoc-ref request "method"))
          (params (if (assoc "params" request)
                      (assoc-ref request "params") '())))
      (cond
       ((or (not (equal? (assoc-ref request "jsonrpc") "2.0"))
            (not (string? method))
            (and (assoc "id" request)
                 (not (or (string? id) (number? id) (eq? id 'null)))))
        (rpc-error 'null -32600 "Expected a JSON-RPC 2.0 request"))
       ((not (assoc "id" request)) #f)
       ((not (object? params))
        (rpc-error id -32602 "Expected object parameters"))
       ((equal? method "initialize")
        (set! initialized? #t)
        (result id
                `((protocolVersion . "2025-11-25")
                  (capabilities (tools (listChanged . #f)))
                  (serverInfo (name . "weft") (version . "0.4.0"))
                  (instructions . ,description))))
       ((equal? method "ping") (result id '()))
       ((not initialized?) (rpc-error id -32002 "Initialize first"))
       ((equal? method "tools/list")
        (result id `((tools . ,(vector (acons 'description description (alist-delete 'description %tool)))))))
       ((equal? method "tools/call")
        (let* ((arguments (assoc-ref params "arguments"))
               (code (and (object? arguments) (assoc-ref arguments "code")))
               (seconds (if (and (object? arguments) (assoc "seconds" arguments))
                            (assoc-ref arguments "seconds") 30)))
          (if (and (equal? (assoc-ref params "name") "evaluate")
                   (object? arguments) (string? code)
                   (<= (string-length code) 131072)
                   (real? seconds) (> seconds 0) (<= seconds 50)
                   (every (lambda (entry)
                            (member (car entry) '("code" "seconds"))) arguments))
              (let ((evaluation
                     (catch #t
                       (lambda () (run code seconds))
                       (lambda (key . args)
                         (let ((message (format #f "Workspace evaluation failed: ~s ~s" key args)))
                           `((generation . #f) (status . error)
                             (value . ,(substring message 0 (min 4096 (string-length message))))
                             (output . "") (truncated . ,(> (string-length message) 4096))))))))
                (result id
                        `((content . ,(vector `((type . "text")
                                                (text . ,(object->string evaluation)))))
                          (isError . ,(not (eq? 'ok (assq-ref evaluation 'status)))))))
              (rpc-error id -32602 "Expected evaluate with code and optional seconds"))))
       (else (rpc-error id -32601 "Unknown method")))))
  (dynamic-wind
    (lambda () #t)
    (lambda ()
      (let loop ()
        (let ((line (read-line input)))
          (unless (eof-object? line)
            (let* ((request (catch #t
                              (lambda () (json-string->scm line))
                              (lambda args 'parse-error)))
                   (reply (cond
                           ((eq? request 'parse-error)
                            (rpc-error 'null -32700 "Invalid JSON"))
                           ((not (object? request))
                            (rpc-error 'null -32600 "Expected one request object"))
                           (else (dispatch request)))))
              (when reply
                (scm->json reply output)
                (newline output)
                (force-output output)))
            (when workspace (workspace-tick! workspace))
            (loop)))))
    (lambda () (when workspace (workspace-close workspace)))))

(define* (serve-stdio #:key (initialize (lambda (module) #t)) (evaluate #f) isolated?)
  "Serve MCP on standard I/O, isolating protocol descriptors from child processes."
  ;; Child processes must not read requests or write into the protocol stream.
  (let* ((input (fdopen (dup 0) "r"))
         (output (fdopen (dup 1) "w"))
         (null (open-input-file "/dev/null")))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (fcntl input F_SETFD FD_CLOEXEC)
        (fcntl output F_SETFD FD_CLOEXEC)
        (dup2 (fileno null) 0)
        (dup2 2 1)
        (serve-mcp input output #:initialize initialize #:evaluate evaluate #:isolated? isolated?))
      (lambda ()
        (close-port null)
        (close-port input)
        (close-port output)))))
