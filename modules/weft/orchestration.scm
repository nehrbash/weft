(define-module (weft orchestration)
  #:use-module (weft jobs)
  #:use-module (weft agents)
  #:use-module (ice-9 sandbox)
  #:use-module (ice-9 copy-tree)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:export (make-orchestration install-orchestration-bindings!
            orchestration-tick! orchestration-close!
            orchestration-snapshot orchestration-restore!))

(define-record-type <orchestration>
  (%make-orchestration manager module next agents turns events seen hooks messages
                       notifications notifier commands closed?)
  orchestration?
  (manager manager)
  (module workspace-module)
  (next next-id set-next-id!)
  (agents agents set-agents!)
  (turns turns set-turns!)
  (events events set-events!)
  (seen seen set-seen!)
  (hooks hooks set-hooks!)
  (messages messages set-messages!)
  (notifications notifications set-notifications!)
  (notifier notifier set-notifier!)
  (commands commands set-commands!)
  (closed? closed? set-closed!))

(define (make-orchestration manager module)
  (%make-orchestration manager module 1 '() '() '() '() '() '() '() #f '() #f))

(define (fresh-id! state)
  (let ((id (next-id state))) (set-next-id! state (+ id 1)) id))

(define (ensure-open state)
  (when (closed? state) (error "Orchestration is closed")))

(define (bounded text limit)
  (if (> (string-length text) limit) (substring text 0 limit) text))

(define (set-field! record key value)
  (set-cdr! (assq key record) value))

(define (find-turn state id)
  (or (assv-ref (turns state) id) (error "Unknown turn" id)))

(define (active? turn)
  (memq (assq-ref turn 'state) '(queued running cancelling)))

(define current-event-depth (make-parameter -1))

(define (agent state name)
  (or (assq-ref (agents state) name) (error "Unknown agent" name)))

(define* (agent-register! state name provider #:key (cwd (getcwd)))
  (ensure-open state)
  (unless (and (symbol? name) (memq provider '(codex claude))
               (string? cwd) (file-is-directory? cwd))
    (error "Expected agent symbol, codex/claude provider and existing cwd"))
  (when (any (lambda (entry)
               (and (eq? name (assq-ref (cdr entry) 'agent)) (active? (cdr entry))))
             (turns state))
    (error "Cannot replace an agent with pending turns" name))
  (when (and (not (assq name (agents state))) (>= (length (agents state)) 64))
    (error "Agent limit reached"))
  (set-agents! state
    (acons name (copy-tree `((provider . ,provider) (cwd . ,(canonicalize-path cwd)) (session . #f)))
           (alist-delete name (agents state))))
  name)

(define* (agent-send! state name prompt #:key cause)
  (ensure-open state)
  (agent state name)
  (unless (and (string? prompt) (<= 1 (string-length prompt) 65536))
    (error "Prompt must contain 1..65536 characters"))
  (when (>= (count (lambda (entry)
                     (and (eq? name (assq-ref (cdr entry) 'agent)) (active? (cdr entry))))
                   (turns state)) 16)
    (error "Agent queue is full" name))
  (when (>= (length (turns state)) 128)
    (let ((old (find (lambda (entry) (not (active? (cdr entry)))) (reverse (turns state)))))
      (unless old (error "Turn queue is full"))
      (set-turns! state (alist-delete (car old) (turns state) eqv?))))
  (let* ((id (fresh-id! state))
         (turn (copy-tree `((id . ,id) (agent . ,name) (state . queued) (cause . ,cause)
                 (prompt . ,(string-copy prompt)) (job . #f) (spec . #f)
                 (text . #f) (error . #f) (exit-code . #f) (stderr . "")))))
    (set-turns! state (acons id turn (turns state)))
    id))

(define (turn-status state id)
  (copy-tree (filter (lambda (entry) (not (memq (car entry) '(prompt spec))))
                     (find-turn state id))))

(define* (owner-post! state text #:key (from 'owner) turn)
  (ensure-open state)
  (unless (and (string? text) (<= (string-length text) 65536) (symbol? from))
    (error "Expected message text up to 65536 characters and sender symbol"))
  (let* ((id (fresh-id! state))
         (message `((id . ,id) (from . ,from) (text . ,(bounded text 16384)) (turn . ,turn))))
    (set-messages! state (take (cons message (messages state))
                              (min 256 (+ 1 (length (messages state))))))
    (when (notifier state)
      (set-notifications! state
        (take (cons message (notifications state))
              (min 256 (+ 1 (length (notifications state)))))))
    id))

(define (finish! state turn status text error)
  (set-field! turn 'state status)
  (set-field! turn 'text (and text (bounded text 16384)))
  (set-field! turn 'error (and error (bounded error 4096)))
  (set-field! turn 'prompt #f)
  (set-field! turn 'spec #f)
  (owner-post! state (or (assq-ref turn 'error) (assq-ref turn 'text) (symbol->string status))
               #:from (assq-ref turn 'agent) #:turn (assq-ref turn 'id)))

(define (turn-cancel! state id)
  (let ((turn (find-turn state id)))
    (case (assq-ref turn 'state)
      ((queued) (finish! state turn 'cancelled #f "Turn cancelled"))
      ((running cancelling)
       (set-field! turn 'state 'cancelling)
       (catch #t
         (lambda () (job-cancel (manager state) (assq-ref turn 'job)))
         (lambda (key . args)
           (finish! state turn 'failed #f
                    (bounded (format #f "Job cancellation failed: ~s ~s" key args) 4096))))))
    (turn-status state id)))

(define* (event-emit! state topic payload #:key (source 'local) key)
  (ensure-open state)
  (when (>= (current-event-depth) 8) (error "Event cascade exceeded eight hops"))
  (unless (and (symbol? topic) (symbol? source)
               (<= (string-length (object->string payload)) 65536)
               (or (not key) (and (string? key) (<= (string-length key) 256))))
    (error "Invalid topic/source, payload exceeds 64 KiB, or key exceeds 256 characters"))
  (let* ((dedup-key (and key (list source key)))
         (existing (and key (assoc-ref (seen state) dedup-key))))
    (or existing
        (begin
          ;; Reserve space for the current batch's unfinished subscribers.
          (when (>= (length (events state)) (if (< (current-event-depth) 0) 128 124))
            (error "Event queue is full"))
          (let ((id (fresh-id! state)))
            (set-events! state
              (append (events state)
                      (list `((id . ,id) (topic . ,topic) (payload . ,(copy-tree payload))
                              (source . ,source) (depth . ,(+ 1 (current-event-depth)))))))
            (when key
              (set-seen! state
                (take (acons dedup-key id (seen state))
                      (min 256 (+ 1 (length (seen state)))))))
            id)))))

(define (event-on! state name topic command)
  (unless (and (symbol? name) (symbol? topic) (symbol? command))
    (error "Hook name, topic and command must be symbols"))
  (when (and (not (assq name (hooks state))) (>= (length (hooks state)) 128))
    (error "Hook limit reached"))
  (set-hooks! state (acons name (cons topic command) (alist-delete name (hooks state))))
  name)

(define (invoke state command argument)
  (call-with-time-limit
    1
    (lambda ()
      (let ((procedure (module-ref (workspace-module state) command)))
        (unless (procedure? procedure) (error "Command is not a procedure" command))
        (let ((dispatch (module-ref (workspace-module state) 'command-invoke #f)))
          (if dispatch (dispatch command argument) (procedure argument)))))
    (lambda () (error "Command exceeded one second" command))))

(define (dispatch-event! state event)
  (let ((pending (if (assq 'pending event)
                     (assq-ref event 'pending)
                     (map car (filter (lambda (hook) (eq? (assq-ref event 'topic) (cadr hook)))
                                      (reverse (hooks state)))))))
    (when (pair? pending)
      (let ((hook (assq (car pending) (hooks state))))
        (when (and hook (eq? (cadr hook) (assq-ref event 'topic)))
          (catch #t
            (lambda ()
              (parameterize ((current-event-depth (assq-ref event 'depth)))
                (invoke state (cddr hook) (copy-tree event))))
            (lambda (key . args)
              (owner-post! state
                (bounded (format #f "Hook ~a failed: ~s ~s" (car hook) key args) 4096)
                #:from 'weft)))))
      (when (pair? (cdr pending))
        (set-events! state
          (append (events state)
                  (list (acons 'pending (cdr pending) (alist-delete 'pending event)))))))))

(define (collect-known-turn! state turn)
  (let* ((id (assq-ref turn 'job))
         (status (job-status (manager state) id)))
    (when (or (assq-ref status 'exit-code) (assq-ref status 'signal))
      (set-field! turn 'exit-code (assq-ref status 'exit-code))
      (set-field! turn 'stderr (bounded (assq-ref status 'stderr) 4096))
      (if (eq? (assq-ref turn 'state) 'cancelling)
          (finish! state turn 'cancelled #f "Turn cancelled")
          (catch #t
            (lambda ()
              (let* ((result (provider-result (assq-ref turn 'spec) status))
                     (error (assq-ref result 'error))
                     (session (assq-ref result 'session)))
                (when (and session (not error))
                  (set-field! (agent state (assq-ref turn 'agent)) 'session session))
                (finish! state turn (if error 'failed 'completed)
                         (assq-ref result 'text) error)))
            (lambda (key . args)
              (finish! state turn 'failed #f
                       (bounded (format #f "Provider result failed: ~s ~s" key args) 4096)))))
      (job-forget (manager state) id))))

(define (collect-turn! state turn)
  (catch #t
    (lambda () (collect-known-turn! state turn))
    (lambda (key . args)
      (finish! state turn 'failed #f
               (bounded (format #f "Job collection failed: ~s ~s" key args) 4096)))))

(define (start-turn! state turn)
  (catch #t
    (lambda ()
      (let* ((config (agent state (assq-ref turn 'agent)))
             (spec (provider-start-spec (assq-ref config 'provider)
                      (assq-ref turn 'prompt) (assq-ref config 'cwd)
                      (assq-ref config 'session)))
             (job (job-start (manager state) (assq-ref spec 'argv)
                    #:cwd (assq-ref spec 'cwd) #:stdin (assq-ref spec 'stdin)
                    #:output-limit (assq-ref spec 'capture-limit))))
        (set-field! turn 'spec spec)
        (set-field! turn 'job (assq-ref job 'id))
        (set-field! turn 'state 'running)))
    (lambda (key . args)
      (finish! state turn 'failed #f
               (bounded (format #f "Provider start failed: ~s ~s" key args) 4096)))))

(define (orchestration-tick! state)
  "Dispatch a bounded batch on the serialized workspace executor."
  (unless (closed? state)
    (for-each (lambda (entry)
                (when (memq (assq-ref (cdr entry) 'state) '(running cancelling))
                  (collect-turn! state (cdr entry))))
              (reverse (turns state)))
    (let ((batch (take (events state) (min 4 (length (events state))))))
      (set-events! state (drop (events state) (length batch)))
      (for-each (lambda (event) (dispatch-event! state event)) batch))
    (for-each
      (lambda (entry)
        (let ((turn (cdr entry)))
          (when (and (eq? (assq-ref turn 'state) 'queued)
                     (< (count (lambda (pair)
                                 (memq (assq-ref (cdr pair) 'state) '(running cancelling)))
                               (turns state)) 4)
                     (not (any (lambda (pair)
                                 (and (memq (assq-ref (cdr pair) 'state) '(running cancelling))
                                      (eq? (assq-ref turn 'agent) (assq-ref (cdr pair) 'agent))))
                               (turns state))))
            (start-turn! state turn))))
      (reverse (turns state)))
    (let ((pending (take-right (notifications state) (min 1 (length (notifications state))))))
      (set-notifications! state (drop-right (notifications state) (length pending)))
      (for-each
        (lambda (message)
          (when (notifier state)
            (catch #t
              (lambda () (invoke state (notifier state) (copy-tree message)))
              (lambda (key . args)
                (let ((command (notifier state)))
                  (set-notifier! state #f)
                  (owner-post! state
                    (bounded (format #f "Notification ~a disabled: ~s ~s" command key args) 4096)
                    #:from 'weft))))))
        (reverse pending))))
  #t)

(define (orchestration-close! state)
  (unless (closed? state)
    (for-each (lambda (entry)
                (when (active? (cdr entry)) (turn-cancel! state (car entry))))
              (turns state))
    (set-events! state '())
    (set-notifications! state '())
    (set-closed! state #t))
  #t)

(define (orchestration-snapshot state)
  (copy-tree `((next . ,(next-id state)) (agents . ,(agents state))
               (turns . ,(turns state)) (seen . ,(seen state))
               (messages . ,(messages state)) (hooks . ,(hooks state))
               (commands . ,(commands state)))))

(define (orchestration-restore! state snapshot)
  (set-next-id! state (assq-ref snapshot 'next))
  (set-agents! state (assq-ref snapshot 'agents))
  (set-turns! state (assq-ref snapshot 'turns))
  (set-seen! state (assq-ref snapshot 'seen))
  (set-messages! state (assq-ref snapshot 'messages))
  (set-hooks! state (or (assq-ref snapshot 'hooks) '()))
  (set-commands! state (or (assq-ref snapshot 'commands) '()))
  (for-each
    (lambda (entry)
      (when (active? (cdr entry))
        (finish! state (cdr entry) 'interrupted #f
                 "Workspace restarted; turn was not replayed")))
    (turns state)))

(define (install-orchestration-bindings! state)
  (define (bind name procedure) (module-define! (workspace-module state) name procedure))
  (bind 'agent-register! (lambda* (name provider #:key (cwd (getcwd)))
                          (agent-register! state name provider #:cwd cwd)))
  (bind 'agent-list (lambda () (copy-tree (agents state))))
  (bind 'agent-send! (lambda* (name prompt #:key cause)
                      (agent-send! state name prompt #:cause cause)))
  (bind 'turn-status (lambda (id) (turn-status state id)))
  (bind 'turn-list (lambda () (map (lambda (entry) (turn-status state (car entry)))
                                 (reverse (turns state)))))
  (bind 'turn-cancel! (lambda (id) (turn-cancel! state id)))
  (bind 'event-emit! (lambda* (topic payload #:key (source 'local) key)
                      (event-emit! state topic payload #:source source #:key key)))
  (bind 'event-on! (lambda (name topic command) (event-on! state name topic command)))
  (bind 'event-off! (lambda (name)
                     (set-hooks! state (alist-delete name (hooks state))) #t))
  (bind 'event-hooks (lambda () (copy-tree (hooks state))))
  (bind 'owner-post! (lambda* (text #:key (from 'owner))
                      (owner-post! state text #:from from)))
  (bind 'owner-messages (lambda* (#:optional (after 0))
                         (copy-tree (reverse (filter (lambda (message) (> (assq-ref message 'id) after))
                                                     (messages state))))))
  (bind 'owner-notify! (lambda (command)
                        (unless (or (not command) (symbol? command))
                          (error "Expected command symbol or #f"))
                        (set-notifier! state command) command))
  (bind 'command-register! (lambda (name procedure)
                            (unless (and (symbol? name) (procedure? procedure))
                              (error "Expected symbol and procedure"))
                            (bind name procedure)
                            (set-commands! state (cons name (delq name (commands state)))) name))
  (bind 'command-list (lambda () (list-copy (commands state))))
  (bind 'command-remove! (lambda (name)
                          (when (memq name (commands state))
                            (module-remove! (workspace-module state) name)
                            (set-commands! state (delq name (commands state)))) #t))
  (bind 'orchestration-state
    (lambda () `((agents . ,(length (agents state))) (turns . ,(length (turns state)))
                 (queued-events . ,(length (events state))) (messages . ,(length (messages state)))
                 (persistence . ,(let ((inspect (module-ref (workspace-module state) 'workspace-state #f)))
                                   (if inspect (assq-ref (inspect) 'persistence) 'process)))
                 (dedup-window . 256) (concurrency . 4)))))
