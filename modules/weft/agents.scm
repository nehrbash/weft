(define-module (weft agents)
  #:use-module (json)
  #:use-module (ice-9 rdelim)
  #:use-module (srfi srfi-1)
  #:export (provider-start-spec provider-result))

(define %capture-limit 1048576)

(define (nonempty-string? value)
  (and (string? value) (positive? (string-length value))))

(define (provider-start-spec provider prompt cwd session)
  "Describe an owned headless turn using the provider's existing CLI configuration."
  (unless (memq provider '(claude codex))
    (error "Unsupported agent provider" provider))
  (unless (and (nonempty-string? prompt)
               (<= (string-length prompt) %capture-limit))
    (error "Expected a nonempty prompt of at most 1 MiB"))
  (unless (and (nonempty-string? cwd) (string-prefix? "/" cwd)
               (eq? 'directory (stat:type (stat cwd))))
    (error "Expected an absolute working directory" cwd))
  (unless (or (not session)
              (and (nonempty-string? session)
                   (not (string-prefix? "-" session))))
    (error "Expected a session ID or #f" session))
  `((provider . ,provider)
    (session . ,session)
    (cwd . ,cwd)
    (stdin . ,prompt)
    (capture-limit . ,%capture-limit)
    (argv . ,(case provider
               ((claude)
                (append '("claude" "-p" "--output-format" "json"
                          "--permission-prompts" "none")
                        (if session (list "--resume" session) '())))
               ((codex)
                (append '("codex" "exec")
                        (if session (list "resume" session) '())
                        '("--json" "-")))))))

(define (outcome text session error)
  `((text . ,text) (session . ,session) (error . ,error)))

(define (read-claude output)
  (let ((result (json-string->scm output)))
    (unless (and (list? result)
                 (equal? "result" (assoc-ref result "type"))
                 (equal? "success" (assoc-ref result "subtype"))
                 (eq? #f (assoc-ref result "is_error"))
                 (assoc "is_error" result)
                 (string? (assoc-ref result "result"))
                 (nonempty-string? (assoc-ref result "session_id")))
      (error "Claude did not return a successful result with a session ID"))
    (outcome (assoc-ref result "result") (assoc-ref result "session_id") #f)))

(define (read-codex output expected-session)
  (call-with-input-string output
    (lambda (port)
      (let loop ((session expected-session) (text #f) (complete? #f))
        (let ((line (read-line port)))
          (if (eof-object? line)
              (if (and complete? (nonempty-string? session) (string? text))
                  (outcome text session #f)
                  (error "Codex output lacks a completed turn, message or session ID"))
              (if (string-null? line)
                  (loop session text complete?)
                  (let* ((event (json-string->scm line))
                         (type (assoc-ref event "type")))
                    (cond
                     ((equal? type "thread.started")
                      (let ((id (assoc-ref event "thread_id")))
                        (unless (nonempty-string? id) (error "Invalid Codex thread ID"))
                        (loop id text complete?)))
                     ((member type '("error" "turn.failed"))
                      (error "Codex reported a failed turn"))
                     ((equal? type "turn.completed") (loop session text #t))
                     ((equal? type "item.completed")
                      (let ((item (assoc-ref event "item")))
                        (loop session
                              (if (equal? (assoc-ref item "type") "agent_message")
                                  (assoc-ref item "text") text)
                              complete?)))
                     (else (loop session text complete?)))))))))))

(define (provider-result spec status)
  "Decode a complete provider result; truncated output is never accepted."
  (let ((session (assq-ref spec 'session))
        (output (assq-ref status 'stdout)))
    (cond
     ((assq-ref status 'truncated)
      (outcome #f session "Provider output exceeded the capture limit"))
     ((not (and (eq? 'exited (assq-ref status 'state))
                (equal? 0 (assq-ref status 'exit-code))
                (not (assq-ref status 'signal))))
      (outcome #f session "Provider process did not exit successfully"))
     ((not (and (string? output) (<= (string-length output) %capture-limit)))
      (outcome #f session "Invalid or oversized provider output"))
     (else
      (catch #t
        (lambda ()
          (let ((result (case (assq-ref spec 'provider)
                          ((claude) (read-claude output))
                          ((codex) (read-codex output session))
                          (else (error "Unsupported agent provider")))))
            (if (and session (not (equal? session (assq-ref result 'session))))
                (outcome #f session "Provider resumed a different session")
                result)))
        (lambda args (outcome #f session "Malformed or unsuccessful provider result")))))))
