(define-module (weft runtime)
  #:use-module (ares evaluation eval)
  #:use-module (ice-9 sandbox)
  #:use-module (rnrs io ports)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-11)
  #:use-module (weft jobs)
  #:use-module (weft orchestration)
  #:use-module (weft state)
  #:use-module (weft advice)
  #:use-module (srfi srfi-1)
  #:export (make-workspace workspace-evaluate workspace-help workspace-state
            workspace-close workspace-tick! make-room room-evaluate room-help room-state))

(define-record-type <workspace>
  (%make-workspace module generation jobs orchestration path saved advice zones snapshot isolated effects)
  workspace?
  (module workspace-module)
  (generation workspace-generation)
  (jobs workspace-jobs)
  (orchestration workspace-orchestration)
  (path workspace-path)
  (saved workspace-saved set-workspace-saved!)
  (advice workspace-advice)
  (zones workspace-zones set-workspace-zones!)
  (snapshot workspace-snapshot set-workspace-snapshot!)
  (isolated workspace-isolated?)
  (effects workspace-effects set-workspace-effects!))

(define (checkpoint! workspace)
  (when (workspace-path workspace)
    (let ((snapshot `((version . 1) (saved . ,(workspace-saved workspace))
        (zones . ,(workspace-zones workspace))
        (advice . ,(vector-ref (workspace-advice workspace) 0))
        (orchestration . ,(orchestration-snapshot (workspace-orchestration workspace))))))
      (unless (equal? snapshot (workspace-snapshot workspace))
        (write-state! (workspace-path workspace) snapshot)
        (set-workspace-snapshot! workspace (copy-data snapshot))))))

(define (bounded-output limit)
  (let ((parts '())
        (size 0)
        (truncated? #f))
    (define (write-part text start count)
      (let ((keep (min count (- limit size))))
        (when (> keep 0)
          (set! parts (cons (substring text start (+ start keep)) parts))
          (set! size (+ size keep)))
        (when (< keep count)
          (set! truncated? #t))
        count))
    (values (make-custom-textual-output-port "bounded-result" write-part #f #f #f)
            (lambda () (string-concatenate (reverse parts)))
            (lambda () truncated?))))

(define (workspace-state workspace)
  "Return workspace identity and persistence boundaries."
  `((generation . ,(workspace-generation workspace))
    (persistence . ,(if (workspace-path workspace) 'snapshot 'process))
    (authority . ,(if (workspace-isolated? workspace) 'isolated 'local-user))
    (sandbox . ,(workspace-isolated? workspace))))

(define (workspace-help workspace)
  "Describe this workspace's available operations and authority."
  (append
    '((evaluate . "Definitions survive calls. Exceptions preserve earlier effects; there is no rollback. Use workspace-state to detect a generation change.")
      (saved . "saved-define! takes a name and quoted expression; saved-set! saves readable data. saved-list inspects definitions; saved-remove! stops restoring one. Only explicitly saved definitions and values survive restart. Definition expressions are evaluated during recovery; keep them free of external effects.")
      (zones . "zone-set! accepts a name, text/table/metric/wiring type and readable data. zone-list inspects rendered data; zone-remove! removes a zone. Owner layout is controlled in the Emacs console.")
      (advice . "advice-add! takes a name, target, before/after/around kind, and procedure symbol. Targets include workspace-evaluate, workspace-tick and command-invoke targets. Around advice receives a zero-argument next procedure followed by the arguments. Use advice-list and advice-remove! to inspect or remove it.")
      (limits . "Results are bounded. Evaluation accepts a deadline up to 50 seconds. Retain large values and retrieve summaries."))
    (if (workspace-isolated? workspace)
        '((authority . "Restricted Scheme in a Bubblewrap worker: no home directory or host network. The trusted maintenance endpoint is separate and has local-user authority.")
          (effects . "effect-propose! takes notify/write-file/run/session-send and a payload. Notify takes text; write-file takes (absolute-path text) and creates a new file; run takes (absolute-cwd argv); session-send takes (target prompt), where target is an ACP buffer name or codex:THREAD-ID. The owner reviews exact content in weft-console. A proposal is not permission and does not execute automatically.")
          (recovery . "The room broker saves explicit definitions, values and zones. Ordinary definitions last until worker restart. Approvals are single-use; interrupted effects are never automatically replayed."))
        '((authority . "Trusted local-user REPL. It is not protected by the isolated room's approval gate.")
          (jobs . "job-start takes argv with optional cwd, stdin and output-limit. job-status/job-list inspect; job-wait waits up to 10 seconds; job-cancel stops; job-forget removes completed jobs.")
          (agents . "agent-register! takes a name, codex/claude provider and optional cwd. agent-send! queues a prompt; turn-list and turn-status inspect completion; turn-cancel! cancels.")
          (events . "event-on! registers a named topic/command hook; event-emit! queues payloads; event-hooks and event-off! inspect and remove hooks. Commands resolve when invoked.")
          (owner . "owner-post! adds an attributed inbox message; owner-messages reads it. owner-notify! configures a delivery callback. Callback success does not prove visible delivery.")
          (commands . "command-register!, command-list, command-remove! and command-invoke expose live commands. orchestration-state summarizes queues. Save the procedure expression explicitly for restart recovery.")
          (recovery . "WEFT_STATE_FILE enables private snapshots. Explicit definitions, zones, advice, hooks, sessions and inbox survive restart. Pending turns become interrupted; jobs and queued events are not replayed.")))))

(define (install-bindings! workspace)
  (let ((module (workspace-module workspace))
        (manager (workspace-jobs workspace)))
    (define (bind name procedure)
      (module-define! module name procedure))
    (bind 'workspace-state (lambda () (workspace-state workspace)))
    (bind 'workspace-help (lambda () (workspace-help workspace)))
    (bind 'room-state (module-ref module 'workspace-state))
    (bind 'room-help (module-ref module 'workspace-help))
    (install-advice-bindings! (workspace-advice workspace) module)
    (bind 'command-invoke
      (lambda (name . arguments)
        (advice-call (workspace-advice workspace) module name (module-ref module name) arguments)))
    (bind 'saved-define!
      (lambda (name expression)
        (unless (and (symbol? name) (data? expression))
          (error "Expected a symbol and readable definition expression"))
        (when (and (not (assq name (workspace-saved workspace)))
                   (>= (length (workspace-saved workspace)) 128))
          (error "Saved definition limit reached"))
        (let ((value (eval expression module)))
          (module-define! module name value)
          (set-workspace-saved! workspace
            (let ((entry (cons name (copy-data expression)))
                  (saved (workspace-saved workspace)))
              (if (assq name saved)
                  (map (lambda (old) (if (eq? name (car old)) entry old)) saved)
                  (append saved (list entry)))))
          (checkpoint! workspace)
          name)))
    (bind 'saved-set!
      (lambda (name value)
        ((module-ref module 'saved-define!) name (list 'quote (copy-data value)))))
    (bind 'saved-list (lambda () (copy-data (workspace-saved workspace))))
    (bind 'saved-remove!
      (lambda (name)
        (set-workspace-saved! workspace (alist-delete name (workspace-saved workspace)))
        (checkpoint! workspace) #t))
    (bind 'zone-set!
      (lambda (name type value)
        (unless (and (symbol? name) (memq type '(text table metric wiring))
                     (case type
                       ((text) (string? value))
                       ((metric) (or (number? value) (string? value)))
                       ((table) (and (list? value) (every list? value)))
                       ((wiring) (and (list? value)
                                     (every (lambda (edge) (and (list? edge) (= 2 (length edge)))) value))))
                     (data? value))
          (error "Expected a typed text, table, metric or wiring zone"))
        (when (and (not (assq name (workspace-zones workspace)))
                   (>= (length (workspace-zones workspace)) 64))
          (error "Zone limit reached"))
        (set-workspace-zones! workspace
          (acons name (list type (copy-data value)) (alist-delete name (workspace-zones workspace))))
        (checkpoint! workspace) name))
    (bind 'zone-list (lambda () (copy-data (workspace-zones workspace))))
    (bind 'zone-remove!
      (lambda (name)
        (set-workspace-zones! workspace (alist-delete name (workspace-zones workspace)))
        (checkpoint! workspace) #t))
    (bind 'job-start
      (lambda* (argv #:key cwd (stdin "") (output-limit 16384))
        (job-start manager argv #:cwd cwd #:stdin stdin #:output-limit output-limit)))
    (bind 'job-list (lambda () (job-list manager)))
    (bind 'job-status (lambda (id) (job-status manager id)))
    (bind 'job-wait (lambda* (id #:optional (seconds 1))
                      (job-wait manager id seconds)))
    (bind 'job-cancel (lambda (id) (job-cancel manager id)))
    (bind 'job-forget (lambda (id) (job-forget manager id)))))

(define* (make-workspace #:key (initialize (lambda (module) #t)) state-file isolated?)
  "Create a trusted, process-local Scheme workspace."
  (let* ((name (list 'workspace (gensym "session-")))
         (module (if isolated? (make-sandbox-module all-pure-and-impure-bindings)
                     (resolve-module name)))
         (generation (format #f "~a-~a" (getpid) (gettimeofday)))
         (manager (make-job-manager))
         (orchestration (make-orchestration manager module))
         (workspace (%make-workspace module generation manager orchestration
                                     state-file '() (make-advice) '() #f isolated? '())))
    (if isolated?
        (begin (set-module-name! module name) (module-define-submodule! (resolve-module '(workspace))
                                                                     (cadr name) module))
        (module-use! module (resolve-interface '(guile))))
    (install-bindings! workspace)
    (if isolated?
        (begin
          (for-each (lambda (name) (module-remove! module name))
                    '(job-start job-list job-status job-wait job-cancel job-forget))
          (module-define! module 'effect-propose!
            (lambda (type payload)
              (unless (and (memq type '(notify write-file run session-send))
                           (data? payload) (< (length (workspace-effects workspace)) 32))
                (error "Invalid effect proposal or proposal limit reached"))
              (set-workspace-effects! workspace
                (append (workspace-effects workspace) (list (list type (copy-data payload)))))
              (length (workspace-effects workspace)))))
        (install-orchestration-bindings! orchestration))
    (set-module-public-interface! module module)
    (catch #t
      (lambda ()
        (initialize module)
        (let ((snapshot (and state-file (read-state state-file))))
          (when snapshot
            (unless (equal? 1 (assq-ref snapshot 'version))
              (error "Unsupported workspace snapshot version"))
            (set-workspace-saved! workspace (assq-ref snapshot 'saved))
            (set-workspace-zones! workspace (assq-ref snapshot 'zones))
            (vector-set! (workspace-advice workspace) 0 (or (assq-ref snapshot 'advice) '()))
            (for-each (lambda (entry) (module-define! module (car entry) (eval (cdr entry) module)))
                      (workspace-saved workspace))
            (orchestration-restore! orchestration (assq-ref snapshot 'orchestration)))))
      (lambda (key . args)
        (orchestration-close! orchestration)
        (jobs-close manager)
        (apply throw key args)))
    workspace))

(define (workspace-close workspace)
  "Stop managed jobs and release their resources."
  (checkpoint! workspace)
  (orchestration-close! (workspace-orchestration workspace))
  (jobs-close (workspace-jobs workspace)))

(define (workspace-tick! workspace)
  "Dispatch pending orchestration on the evaluator thread."
  (catch #t
    (lambda ()
      (call-with-time-and-allocation-limits 2 67108864
        (lambda ()
          (advice-call (workspace-advice workspace) (workspace-module workspace) 'workspace-tick
                       (lambda () (orchestration-tick! (workspace-orchestration workspace))) '()))))
    (lambda args
      (vector-set! (workspace-advice workspace) 0
        (filter (lambda (entry) (not (eq? (cadr entry) 'workspace-tick)))
                (vector-ref (workspace-advice workspace) 0)))
      (let ((post (module-ref (workspace-module workspace) 'owner-post! #f)))
        (when post (post "Tick advice disabled after failure; inspect and repair its command." #:from 'weft)))))
  (checkpoint! workspace))

(define (evaluate-source workspace code result-port)
  (let* ((request `(("code" . ,code)
                    ("ns" . ,(object->string
                              (module-name (workspace-module workspace))))))
         (result ((evaluation-thunk request)))
         (kind (assq-ref result 'result-type)))
    (case kind
      ((value multiple-values)
       (write (assq-ref result 'eval-value) result-port)
       'ok)
      (else
       (write (assq-ref result 'exception-value) result-port)
       'error))))

(define (evaluate-with-ports workspace code seconds output result-port)
  (call-with-time-limit
   seconds
   (lambda ()
     (parameterize ((current-output-port output)
                    (current-error-port output)
                    (current-warning-port output)
                    (current-input-port (open-input-string "")))
       (call-with-allocation-limit
         (if (workspace-isolated? workspace) 67108864 1073741824)
         (lambda ()
           (advice-call (workspace-advice workspace) (workspace-module workspace)
                        'workspace-evaluate
                        (lambda (code) (evaluate-source workspace code result-port)) (list code)))
         (lambda () 'allocation-limit))))
   (lambda () 'timeout)))

(define* (workspace-evaluate workspace code #:key (seconds 30) (limit 16000))
  "Evaluate CODE and return bounded Scheme result and output fields."
  (unless (and (string? code)
               (<= (string-length code) 131072)
               (real? seconds)
               (> seconds 0)
               (<= seconds 50))
    (error "Expected Scheme source up to 128 KiB and timeout in (0, 50]"))
  (let-values (((output output-text output-truncated?) (bounded-output limit))
               ((result-port result-text result-truncated?) (bounded-output limit)))
    (set-workspace-effects! workspace '())
    (let ((status (evaluate-with-ports workspace code seconds output result-port)))
      (force-output output)
      (force-output result-port)
      (checkpoint! workspace)
      `((generation . ,(workspace-generation workspace))
        (status . ,status)
        (value . ,(result-text))
        (output . ,(output-text))
        (truncated . ,(or (output-truncated?) (result-truncated?)))
        ,@(if (workspace-isolated? workspace)
              `((saved . ,(encode-data (workspace-saved workspace)))
                (zones . ,(encode-data (workspace-zones workspace)))
                (advice . ,(encode-data (vector-ref (workspace-advice workspace) 0)))
                (effects . ,(encode-data (workspace-effects workspace)))) '())))))

(define make-room make-workspace)
(define room-evaluate workspace-evaluate)
(define room-help workspace-help)
(define room-state workspace-state)
