;;; weft-tests.el --- Console and session tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(load (expand-file-name "weft.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest weft-console-renders-typed-zones ()
  (with-temp-buffer
    (weft-console-mode)
    (cl-letf (((symbol-function 'weft--call)
               (lambda (&rest _)
                 "{\"zones\":[{\"name\":\"Status\",\"type\":\"text\",\"display\":\"Ready\"},{\"name\":\"Flow\",\"type\":\"wiring\",\"rows\":[[\"build\",\"review\"]]}],\"effects\":[]}")))
      (weft-refresh)
      (should (string-match-p "Ready" (buffer-string)))
      (should (string-match-p "build → review" (buffer-string)))
      (goto-char (point-min))
      (search-forward "Status")
      (should (equal "Status" (get-text-property (1- (point)) 'weft-zone))))))

(ert-deftest weft-owner-decision-requires-confirmation ()
  (let ((effect '((id . 7) (expected . "(notify \"test\")"))) calls)
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil))
              ((symbol-function 'weft--call-async) (lambda (&rest args) (push args calls))))
      (weft--decide effect "approve")
      (should-not calls))
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
              ((symbol-function 'weft--call-async) (lambda (&rest args) (push args calls)))
              ((symbol-function 'weft-refresh) #'ignore))
      (weft--decide effect "approve")
      (should (equal calls '(("owner" "approve" "7" "(notify \"test\")")))))))

(ert-deftest weft-session-preserves-unsent-input ()
  (with-temp-buffer
    (cl-letf (((symbol-function 'derived-mode-p) (lambda (&rest _) t))
              ((symbol-function 'map-nested-elt) (lambda (&rest _) "session"))
              ((symbol-function 'agent-shell--input) (lambda () "draft")))
      (setq-local agent-shell--state 'fixture)
      (should-error (weft-session-send (buffer-name) "prompt") :type 'user-error))))

(ert-deftest weft-session-queues-busy-turn ()
  (with-temp-buffer
    (let (queued)
      (cl-letf (((symbol-function 'derived-mode-p) (lambda (&rest _) t))
                ((symbol-function 'map-nested-elt) (lambda (&rest _) "session"))
                ((symbol-function 'agent-shell--input) (lambda () nil))
                ((symbol-function 'shell-maker-busy) (lambda () t))
                ((symbol-function 'agent-shell-queue-request) (lambda (prompt) (setq queued prompt))))
        (setq-local agent-shell--state 'fixture)
        (weft-session-send (buffer-name) "follow-up")
        (should (equal queued "follow-up"))))))
