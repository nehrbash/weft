(use-modules (weft runtime) (weft state) (srfi srfi-64))
(test-begin "recovery")
(define runner (test-runner-current))
(define directory (mkdtemp "/tmp/weft-recovery-XXXXXX"))
(define path (string-append directory "/state.scm"))
(define workspace (make-workspace #:state-file path))
(define (evaluate code) (workspace-evaluate workspace code))
(define (value code) (call-with-input-string (assq-ref (evaluate code) 'value) read))
(define generation (assq-ref (workspace-state workspace) 'generation))
(test-equal "save function" 'double
  (value "(saved-define! 'double '(lambda (x) (* x 2)))"))
(test-equal "save data" 'count (value "(saved-set! 'count 21)"))
(value "(saved-set! 'a 1)")
(value "(saved-define! 'b '(+ a 1))")
(value "(saved-set! 'a 2)")
(value "(zone-set! 'result 'metric 42)")
(value "(owner-post! \"keep this\" #:from 'fixture)")
(value "(agent-register! 'fixture 'codex) (agent-send! 'fixture \"must not replay\")")
(workspace-close workspace)
(set! workspace (make-workspace #:state-file path))
(test-equal "definitions and values survive restart" 42 (value "(double count)"))
(test-equal "updating bindings preserves recovery order" 3 (value "b"))
(test-equal "zones survive restart" '((result metric 42)) (value "(zone-list)"))
(test-assert "generation changes" (not (equal? generation (assq-ref (workspace-state workspace) 'generation))))
(test-equal "queued turn becomes interrupted" 'interrupted
  (value "(assq-ref (car (turn-list)) 'state)"))
(test-equal "owner inbox survives" "keep this"
  (value "(assq-ref (car (owner-messages)) 'text)"))
(value "(define calls 0) (define (before code) (set! calls (+ calls 1))) (advice-add! 'counter 'workspace-evaluate 'before 'before)")
(test-equal "advice invokes live command" 1 (value "calls"))
(evaluate "(define (before code) (set! calls (+ calls 10)))")
(test-equal "advice follows replacement" 12 (value "calls"))
(value "(advice-remove! 'counter)")
(test-equal "removed advice stays removed" 22 (value "calls"))
(test-equal "non-readable data rejected" 'error
  (assq-ref (evaluate "(saved-set! 'bad (lambda () #t))") 'status))
(test-equal "invalid zone rejected" 'error
  (assq-ref (evaluate "(zone-set! 'bad 'table 42)") 'status))
(value "(define (bad-tick) (error \"broken\")) (advice-add! 'bad 'workspace-tick 'before 'bad-tick)")
(workspace-tick! workspace)
(test-equal "failed tick advice is removed" '() (value "(advice-list)"))
(test-equal "evaluation survives tick failure" 42 (value "(double count)"))
(workspace-close workspace)
(let ((old (read-state path)))
  (test-error "invalid snapshot leaves previous file" #t (write-state! path (lambda () #t)))
  (test-error "oversized snapshot is rejected" #t
    (write-state! path (make-list 65 (make-string 131072 #\x))))
  (test-equal "previous snapshot preserved" old (read-state path)))
(chmod path #o644)
(test-error "insecure state refused" #t (read-state path))
(delete-file path)
(test-equal "tagged data round trip"
  '(hello #:key #\x #t 2/3 #(1 "a"))
  (decode-data (encode-data '(hello #:key #\x #t 2/3 #(1 "a")))))
(test-error "wire decoder refuses reader allocation syntax" #t
  (decode-data "#1@0:100000000()"))
(rmdir directory)
(test-end "recovery")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
