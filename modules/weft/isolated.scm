(define-module (weft isolated)
  #:use-module (weft daemon)
  #:use-module (weft jobs)
  #:use-module (weft state)
  #:use-module (weft connectors)
  #:use-module (ice-9 match)
  #:use-module (ice-9 rdelim)
  #:use-module (ice-9 sandbox)
  #:use-module (json)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:export (serve-isolated owner-request))

(define (store-paths paths)
  (delete-duplicates
    (filter-map (lambda (path)
                  (and (file-exists? path)
                       (let ((real (canonicalize-path path)))
                         (and (string-prefix? "/gnu/store/" real) real)))) paths)))

(define (worker-argv directory)
  (let* ((source (dirname (dirname (search-path %load-path "weft/runtime.scm"))))
         (guile (readlink "/proc/self/exe")))
    (append (list (or (getenv "WEFT_BWRAP") "bwrap")
                  "--unshare-all" "--die-with-parent" "--new-session"
                  "--ro-bind" "/gnu/store" "/gnu/store"
                  "--ro-bind" source "/weft"
                  "--bind" directory "/run/weft"
                  "--proc" "/proc" "--dev" "/dev" "--tmpfs" "/tmp"
                  "--chdir" "/tmp" "--clearenv"
                  "--setenv" "GUILE_LOAD_PATH"
                  (string-join (cons "/weft" (store-paths %load-path)) ":")
                  "--setenv" "GUILE_LOAD_COMPILED_PATH"
                  (string-join (store-paths %load-compiled-path) ":")
                  guile "--no-auto-compile" "-c"
                  "(use-modules (weft daemon)) (setrlimit 'as 1073741824 1073741824) (setrlimit 'core 0 0) (serve-workspace \"/run/weft/worker.sock\" #:isolated? #t #:external-persistence? #t)"))))

(define (valid-payload? type payload)
  (define (strings? value)
    (and (list? value) (pair? value)
         (every (lambda (item) (and (string? item) (not (string-index item #\nul)))) value)))
  (and (data? payload)
       (case type
         ((notify) (and (string? payload) (<= 1 (string-length payload) 16384)))
         ((write-file) (match payload
                         ((path text) (and (string? path) (string-prefix? "/" path)
                                           (not (string-index path #\nul)) (string? text)))
                         (_ #f)))
         ((run) (match payload
                  ((cwd argv) (and (string? cwd) (string-prefix? "/" cwd)
                                    (not (string-index cwd #\nul)) (strings? argv)))
                  (_ #f)))
         ((session-send) (match payload
                           ((session prompt) (and (string? session) (string? prompt)
                                                  (positive? (string-length prompt))))
                           (_ #f)))
         (else #f))))

(define (owner-request socket token operation . arguments)
  "Submit an authenticated owner operation over the local room transport."
  (remote-evaluate socket
    (string-append "WEFT-OWNER "
      (scm->json-string `((token . ,token) (operation . ,(symbol->string operation))
                         (arguments . ,(encode-data arguments)))))))

(define* (serve-isolated socket state-file token-file #:key
                          (execute execute-effect))
  "Serve isolated Scheme with host-owned, single-use effect approvals."
  (let* ((snapshot (or (read-state state-file)
                       '((version . 1) (next . 1) (saved) (zones) (advice) (effects))))
         (token (call-with-input-file token-file read-line))
         (directory (mkdtemp "/tmp/weft-worker-XXXXXX"))
         (worker-socket (string-append directory "/worker.sock"))
         (manager (make-job-manager))
         (worker #f)
         (generation (format #f "room-~a-~a" (getpid) (gettimeofday))))
    (unless (and (equal? 1 (assq-ref snapshot 'version))
                 (string? token) (>= (string-length token) 64)
                 (= (getuid) (stat:uid (stat token-file)))
                 (zero? (logand #o077 (stat:perms (stat token-file)))))
      (error "Invalid room snapshot or private owner token"))
    (define (set-field! key value)
      (set! snapshot (acons key value (alist-delete key snapshot))))
    (define (save!) (write-state! state-file snapshot))
    (define (result value)
      `((generation . ,generation) (status . ok) (value . ,(object->string value))
        (output . "") (truncated . #f)))
    (define (start!)
      (set! worker (assq-ref (job-start manager (worker-argv directory)) 'id))
      (let loop ((remaining 250))
        (unless (and (file-exists? worker-socket)
                     (catch #t (lambda () (remote-evaluate worker-socket "#t") #t)
                            (lambda _ #f)))
          (let ((status (job-status manager worker)))
            (when (or (assq-ref status 'exit-code) (assq-ref status 'signal))
              (error "Isolated worker failed" (assq-ref status 'stderr))))
          (when (zero? remaining) (error "Isolated worker did not become ready"))
          (usleep 20000)
          (loop (- remaining 1))))
      (for-each
        (lambda (entry)
          (let ((reply (remote-evaluate worker-socket
                         (object->string `(saved-define! ',(car entry) ',(cdr entry))))))
            (unless (eq? 'ok (assq-ref reply 'status))
              (error "Saved definition failed in isolated worker" (car entry)))))
        (assq-ref snapshot 'saved))
      (for-each
        (match-lambda
          ((name type data)
           (remote-evaluate worker-socket (object->string `(zone-set! ',name ',type ',data)))))
        (reverse (assq-ref snapshot 'zones)))
      (for-each
        (match-lambda
          ((name target kind command)
           (remote-evaluate worker-socket
             (object->string `(advice-add! ',name ',target ',kind ',command)))))
        (reverse (or (assq-ref snapshot 'advice) '()))))
    (define (approve! id expected decision)
      (let ((proposal (assv-ref (assq-ref snapshot 'effects) id)))
        (unless (and proposal (eq? 'pending (assq-ref proposal 'state))
                     (equal? expected (list (assq-ref proposal 'type) (assq-ref proposal 'payload)))
                     (memq decision '(approve reject)))
          (error "Proposal changed, already decided, or invalid decision"))
        (set-cdr! (assq 'state proposal) (if (eq? decision 'approve) 'executing 'rejected))
        (save!)
        (when (eq? decision 'approve)
          (catch #t
            (lambda ()
              (let ((receipt (execute (assq-ref proposal 'type) (copy-data (assq-ref proposal 'payload)))))
                (set-cdr! (assq 'receipt proposal) (copy-data receipt))
                (set-cdr! (assq 'state proposal) 'completed)))
            (lambda args
              (set-cdr! (assq 'receipt proposal) (object->string args))
              (set-cdr! (assq 'state proposal) 'failed)))
          (save!))
        (copy-data proposal)))
    (define (worker-evaluate code seconds)
      (unless (and (real? seconds) (< 0 seconds) (<= seconds 50))
        (error "Expected timeout in (0, 50]"))
      (when (or (not worker)
                (memq (assq-ref (job-status manager worker) 'state) '(exited signaled)))
        (when worker (job-forget manager worker))
        (start!))
      (catch #t
        (lambda ()
          (call-with-time-limit (+ seconds 2)
            (lambda () (remote-evaluate worker-socket code #:seconds seconds))
            (lambda () (error "Isolated worker exceeded its deadline"))))
        (lambda args
          (job-cancel manager worker)
          (job-wait manager worker 2)
          (job-forget manager worker)
          (set! worker #f)
          (apply throw args))))
    (define (control text)
      (let* ((request (call-with-time-and-allocation-limits 1 16777216
                        (lambda () (json-string->scm text))))
             (provided (assoc-ref request "token")))
        (unless (and (string? provided) (equal? provided token)) (error "Owner authentication failed"))
        (let ((operation (string->symbol (assoc-ref request "operation")))
              (arguments (decode-data (assoc-ref request "arguments"))))
         (case operation
           ((inspect) (result snapshot))
           ((decide) (result (apply approve! arguments)))
           ((archive)
            (let ((id (car arguments)))
              (unless (memq (assq-ref (assv-ref (assq-ref snapshot 'effects) id) 'state)
                            '(completed failed rejected interrupted))
                (error "Only decided effects can be archived"))
              (set-field! 'effects (alist-delete id (assq-ref snapshot 'effects)))
              (save!) (result id)))
           (else (error "Unknown owner operation"))))))
    (define (evaluate code seconds)
      (catch #t
        (lambda ()
          (if (string-prefix? "WEFT-OWNER " code)
              (control (substring code 11))
              (let* ((reply (worker-evaluate code seconds))
                     (saved (decode-data (assq-ref reply 'saved)))
                     (zones (decode-data (assq-ref reply 'zones)))
                     (advice (decode-data (assq-ref reply 'advice)))
                     (effects (decode-data (assq-ref reply 'effects)))
                     (ids '()))
                (unless (and (list? saved) (<= (length saved) 128)
                             (every (lambda (entry) (and (pair? entry) (symbol? (car entry)))) saved)
                             (list? zones) (<= (length zones) 64)
                             (list? advice) (<= (length advice) 128)
                             (list? effects) (<= (length effects) 32)
                             (every (match-lambda ((type payload) (valid-payload? type payload)) (_ #f)) effects))
                  (error "Invalid isolated worker state"))
                (when (> (+ (length effects) (length (assq-ref snapshot 'effects))) 256)
                  (error "Effect history full; archive decided proposals from the owner console"))
                (set-field! 'saved saved)
                (set-field! 'zones zones)
                (set-field! 'advice advice)
                (for-each
                  (match-lambda
                    ((type payload)
                     (let ((id (assq-ref snapshot 'next)))
                       (set-field! 'next (+ id 1))
                       (set-field! 'effects
                         (acons id (copy-data `((state . pending) (type . ,type) (payload . ,payload) (receipt . #f)))
                                (assq-ref snapshot 'effects)))
                       (set! ids (cons id ids))))) effects)
                (save!)
                (append (filter (lambda (entry) (not (memq (car entry) '(saved zones advice effects)))) reply)
                        `((proposals . ,(object->string (reverse ids))))))))
        (lambda args
          `((generation . ,generation) (status . error) (value . ,(object->string args))
            (output . "") (truncated . #f)))))
    (for-each (lambda (entry)
                (when (eq? 'executing (assq-ref (cdr entry) 'state))
                  (set-cdr! (assq 'state (cdr entry)) 'interrupted)))
              (assq-ref snapshot 'effects))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (start!)
        (save!)
        (serve-workspace socket #:evaluator evaluate))
      (lambda ()
        (jobs-close manager)
        (for-each (lambda (name)
                    (let ((file (string-append directory "/" name)))
                      (when (file-exists? file) (delete-file file))))
                  '("worker.sock" "worker.sock.lock"))
        (rmdir directory)))))
