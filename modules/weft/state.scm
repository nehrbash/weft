(define-module (weft state)
  #:use-module (ice-9 match)
  #:use-module (srfi srfi-1)
  #:use-module (json)
  #:use-module (rnrs bytevectors)
  #:use-module (rnrs io ports)
  #:use-module (ice-9 sandbox)
  #:export (read-state write-state! data? copy-data encode-data decode-data))

(define (encode-data value)
  (unless (data? value) (error "Invalid wire data"))
  (define (encode value)
    (cond ((null? value) #("null"))
          ((pair? value) (vector "pair" (encode (car value)) (encode (cdr value))))
          ((vector? value) (vector "vector" (list->vector (map encode (vector->list value)))))
          ((symbol? value) (vector "symbol" (symbol->string value)))
          ((keyword? value) (vector "keyword" (symbol->string (keyword->symbol value))))
          ((char? value) (vector "char" (string value)))
          ((number? value) (vector "number" (number->string value)))
          ((string? value) (vector "string" value))
          ((boolean? value) (vector "boolean" value))))
  (scm->json-string (encode value)))

(define (decode-data text)
  "Decode bounded tagged JSON without invoking the Scheme reader."
  (unless (and (string? text) (<= (string-length text) 1048576))
    (error "Wire data exceeds limit"))
  (define (decode value depth)
    (unless (< depth 1024) (error "Wire data nesting exceeds limit"))
    (match value
      (#("null") '())
      (#("pair" a b) (cons (decode a (+ depth 1)) (decode b (+ depth 1))))
      (#("vector" (? vector? items)) (list->vector (map (lambda (item) (decode item (+ depth 1))) (vector->list items))))
      (#("symbol" (? string? name)) (string->symbol name))
      (#("keyword" (? string? name)) (symbol->keyword (string->symbol name)))
      (#("char" (? string? name)) (if (= 1 (string-length name)) (string-ref name 0) (error "Invalid character")))
      (#("number" (? string? number))
       (unless (and (< (string-length number) 4096) (not (string-index number #\#)))
         (error "Invalid number encoding"))
       (or (string->number number) (error "Invalid number")))
      (#("string" (? string? string)) string)
      (#("boolean" (? boolean? boolean)) boolean)
      (_ (error "Invalid wire data"))))
  (call-with-time-and-allocation-limits 1 33554432
    (lambda ()
      (let ((value (decode (json-string->scm text) 0)))
        (unless (data? value) (error "Invalid decoded data"))
        value))))

(define (data? value)
  "Accept bounded, acyclic, readable data without procedures or ports."
  (let ((remaining 100000))
    (let walk ((value value) (ancestors '()) (depth 0))
      (set! remaining (- remaining 1))
      (and (> remaining 0) (< depth 1024)
           (cond
            ((or (pair? value) (vector? value))
             (and (not (memq value ancestors))
                  (let ((parents (cons value ancestors)))
                    (if (pair? value)
                        (and (walk (car value) parents (+ depth 1))
                             (walk (cdr value) parents (+ depth 1)))
                        (every (lambda (item) (walk item parents (+ depth 1)))
                               (vector->list value))))))
            ((string? value) (<= (string-length value) 131072))
            (else (or (null? value) (boolean? value) (symbol? value) (keyword? value)
                      (char? value) (number? value))))))))

(define (copy-data value)
  (unless (data? value) (error "Expected bounded readable data"))
  (call-with-input-string (object->string value) read))

(define (check-parent path)
  (let ((info (stat (dirname path))))
    (unless (and (= (stat:uid info) (getuid))
                 (zero? (logand (stat:perms info) #o077)))
      (error "State directory must be private to its owner" (dirname path)))))

(define (read-state path)
  (check-parent path)
  (if (file-exists? path)
      (let ((port (fdopen (open-fdes path (logior O_RDONLY O_NOFOLLOW)) "r")))
        (dynamic-wind
          (lambda () #t)
          (lambda ()
            (let ((info (stat port)))
              (unless (and (eq? (stat:type info) 'regular)
                           (= (stat:uid info) (getuid))
                           (zero? (logand (stat:perms info) #o077))
                           (<= (stat:size info) 8388608))
                (error "Invalid workspace state file" path)))
            (let ((value (read port)))
              (unless (and (data? value) (eof-object? (read port)))
                (error "Invalid workspace state data"))
              value))
          (lambda () (close-port port))))
      #f))

(define (write-state! path value)
  "Atomically replace a private snapshot, preserving the previous file on failure."
  (check-parent path)
  (unless (data? value) (error "Invalid workspace snapshot"))
  (let* ((template (string-append path ".XXXXXX"))
         (port (mkstemp! template)))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (chmod port #o600)
        (let* ((size 0)
               (bounded (make-custom-textual-output-port "snapshot"
                          (lambda (text start count)
                            (let ((part (substring text start (+ start count))))
                              (set! size (+ size (bytevector-length (string->utf8 part))))
                              (when (> size 8388608) (error "Snapshot exceeds 8 MiB"))
                              (display part port) count)) #f #f #f)))
          (write value bounded)
          (newline bounded)
          (force-output bounded)
          (close-port bounded))
        (force-output port)
        (fsync port)
        (close-port port)
        (rename-file template path)
        (let ((directory (open-fdes (dirname path) O_RDONLY)))
          (dynamic-wind (lambda () #t)
                        (lambda () (fsync directory))
                        (lambda () (close-fdes directory)))))
      (lambda ()
        (unless (port-closed? port) (close-port port))
        (when (file-exists? template) (delete-file template))))))
