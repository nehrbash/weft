(use-modules (weft orchestration) (weft jobs) (srfi srfi-64))

(test-begin "orchestration")
(define manager (make-job-manager))
(define workspace (make-module))
(module-use! workspace (resolve-interface '(guile)))
(define state (make-orchestration manager workspace))
(install-orchestration-bindings! state)
(define (call name . args) (apply (module-ref workspace name) args))
(define implementation (resolve-module '(weft orchestration)))
(define original-start (module-ref implementation 'provider-start-spec))
(define original-result (module-ref implementation 'provider-result))
(define sessions '())
(module-define! implementation 'provider-start-spec
  (lambda (provider prompt cwd session)
    (set! sessions (cons session sessions))
    `((argv . ("sh" "-c" ,(cond ((equal? prompt "slow") "sleep 5; cat")
                                 ((equal? prompt "error") "printf broken >&2; exit 3")
                                 ((equal? prompt "large") "head -c 70000 /dev/zero | tr '\\000' x")
                                 (else "cat"))))
      (cwd . ,cwd) (stdin . ,prompt) (capture-limit . 1048576))))
(module-define! implementation 'provider-result
  (lambda (spec status)
    `((text . ,(assq-ref status 'stdout)) (session . "session-1")
      (error . ,(and (not (equal? 0 (assq-ref status 'exit-code))) "provider failed")))))
(define (pump id)
  (let loop ((remaining 300))
    (orchestration-tick! state)
    (let ((status (call 'turn-status id)))
      (if (or (= remaining 0) (memq (assq-ref status 'state) '(completed failed cancelled)))
          status
          (begin (usleep 10000) (loop (- remaining 1)))))))

(test-equal "register agent" 'worker (call 'agent-register! 'worker 'codex #:cwd "/tmp"))
(define first (call 'agent-send! 'worker "hello"))
(test-equal "send queues without blocking" 'queued (assq-ref (call 'turn-status first) 'state))
(test-equal "tick completes provider" 'completed (assq-ref (pump first) 'state))
(test-equal "provider result delivered" "hello" (assq-ref (call 'turn-status first) 'text))
(test-equal "completion posts owner inbox" 'worker
  (assq-ref (car (call 'owner-messages)) 'from))
(test-equal "completed jobs released" '() (job-list manager))
(define second (call 'agent-send! 'worker "next"))
(pump second)
(test-equal "provider session resumed" "session-1" (car sessions))
(define bad (call 'agent-send! 'worker "error"))
(test-equal "provider failure visible" 'failed (assq-ref (pump bad) 'state))
(test-equal "stderr preserved" "broken" (assq-ref (call 'turn-status bad) 'stderr))
(define large (call 'agent-send! 'worker "large"))
(test-equal "large successful result stays successful" 'completed (assq-ref (pump large) 'state))
(test-equal "large result summarized in turn" 16384
  (string-length (assq-ref (call 'turn-status large) 'text)))

(define observed '())
(module-define! workspace 'handler (lambda (event) (set! observed (cons 'old observed))))
(call 'event-on! 'rule 'request 'handler)
(define event-id (call 'event-emit! 'request "payload" #:source 'test #:key "once"))
(test-equal "duplicate returns original ID" event-id
  (call 'event-emit! 'request "payload" #:source 'test #:key "once"))
(module-define! workspace 'handler (lambda (event) (set! observed (cons (assq-ref event 'payload) observed))))
(orchestration-tick! state)
(test-equal "hook resolves live redefinition once" '("payload") observed)
(call 'event-off! 'rule)
(call 'event-emit! 'request "ignored")
(orchestration-tick! state)
(test-equal "removed hook stays removed" '("payload") observed)
(module-define! workspace 'launch
  (lambda (event) (call 'agent-send! 'worker (assq-ref event 'payload) #:cause (assq-ref event 'id))))
(call 'event-on! 'launch-rule 'launch 'launch)
(call 'event-emit! 'launch "event prompt")
(orchestration-tick! state)
(define event-turn (assq-ref (car (reverse (call 'turn-list))) 'id))
(test-equal "event launches actual job" 'completed (assq-ref (pump event-turn) 'state))
(test-equal "event prompt reaches provider" "event prompt" (assq-ref (call 'turn-status event-turn) 'text))

(define slow (call 'agent-send! 'worker "slow"))
(define pending (call 'agent-send! 'worker "later"))
(orchestration-tick! state)
(test-equal "one active turn per agent" 'queued (assq-ref (call 'turn-status pending) 'state))
(call 'turn-cancel! pending)
(test-equal "queued cancellation" 'cancelled (assq-ref (call 'turn-status pending) 'state))
(call 'turn-cancel! slow)
(test-equal "running cancellation" 'cancelled (assq-ref (pump slow) 'state))

(define notified '())
(module-define! workspace 'notify (lambda (message) (set! notified (cons (assq-ref message 'text) notified))))
(call 'owner-notify! 'notify)
(define message-id (call 'owner-post! "owner text"))
(orchestration-tick! state)
(test-equal "owner notification callback" '("owner text") notified)
(test-equal "owner inbox cursor" '() (call 'owner-messages message-id))
(module-define! workspace 'broken (lambda (event) (error "broken hook")))
(call 'event-on! 'broken 'failure 'broken)
(call 'event-emit! 'failure "x")
(orchestration-tick! state)
(test-assert "hook errors visible in owner inbox"
  (string-contains (assq-ref (car (reverse (call 'owner-messages))) 'text) "broken"))

(define callbacks 0)
(module-define! workspace 'count-hook (lambda (event) (set! callbacks (+ callbacks 1))))
(do ((n 0 (+ n 1))) ((= n 6))
  (call 'event-on! (string->symbol (format #f "count-~a" n)) 'count 'count-hook))
(call 'event-emit! 'count #f)
(orchestration-tick! state)
(test-equal "subscriber work is spread across ticks" 1 callbacks)
(do ((n 0 (+ n 1))) ((= n 5)) (orchestration-tick! state))
(test-equal "all subscribers eventually run" 6 callbacks)
(define cascades 0)
(module-define! workspace 'cascade
  (lambda (event)
    (set! cascades (+ cascades 1))
    (call 'event-emit! 'cascade #f)))
(call 'event-on! 'cascade 'cascade 'cascade)
(call 'event-emit! 'cascade #f)
(do ((n 0 (+ n 1))) ((= n 12)) (orchestration-tick! state))
(test-equal "event cascades stop" 9 cascades)
(test-equal "cascade queue drained" 0 (assq-ref (call 'orchestration-state) 'queued-events))

(define retargeted 0)
(module-define! workspace 'first-hook (lambda (event) #t))
(module-define! workspace 'second-hook (lambda (event) (set! retargeted (+ 1 retargeted))))
(call 'event-on! 'first 'original-topic 'first-hook)
(call 'event-on! 'second 'original-topic 'second-hook)
(call 'event-emit! 'original-topic #f)
(orchestration-tick! state)
(call 'event-on! 'second 'new-topic 'second-hook)
(orchestration-tick! state)
(test-equal "retargeted subscriber does not receive old topic" 0 retargeted)

(define forgotten (call 'agent-send! 'worker "forgotten"))
(orchestration-tick! state)
(define forgotten-job (assq-ref (call 'turn-status forgotten) 'job))
(job-wait manager forgotten-job 2)
(job-forget manager forgotten-job)
(orchestration-tick! state)
(test-equal "externally forgotten job fails turn without breaking tick" 'failed
  (assq-ref (call 'turn-status forgotten) 'state))
(define forgotten-cancel (call 'agent-send! 'worker "forgotten cancel"))
(orchestration-tick! state)
(define forgotten-cancel-job (assq-ref (call 'turn-status forgotten-cancel) 'job))
(job-wait manager forgotten-cancel-job 2)
(job-forget manager forgotten-cancel-job)
(test-equal "missing job cancellation stays observable" 'failed
  (assq-ref (call 'turn-cancel! forgotten-cancel) 'state))

(call 'command-register! 'command (lambda (event) 'one))
(test-equal "command inspection" '(command) (call 'command-list))
(call 'command-remove! 'command)
(test-equal "command removal" '() (call 'command-list))
(test-error "unknown turn" #t (call 'turn-status 99999))

(define other-manager (make-job-manager))
(define other-module (make-module))
(define other (make-orchestration other-manager other-module))
(install-orchestration-bindings! other)
(define emit (module-ref other-module 'event-emit!))
(do ((n 0 (+ n 1))) ((= n 128)) (emit 'full n))
(test-error "bounded event queue" #t (emit 'full "retry" #:key "retry"))
(orchestration-tick! other)
(test-assert "rejected event can retry" (integer? (emit 'full "retry" #:key "retry")))
(orchestration-close! other)
(jobs-close other-manager)
(orchestration-close! state)
(jobs-close manager)
(test-error "closed state rejects new turns" #t (call 'agent-send! 'worker "late"))
(module-define! implementation 'provider-start-spec original-start)
(module-define! implementation 'provider-result original-result)
(define runner (test-runner-current))
(test-end "orchestration")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
